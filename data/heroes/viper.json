{"id":47,"slug":"viper","name":"冥界亚龙","en":"Viper","aliases":["毒龙","viper"],"attr":"agi","attrLabel":"敏捷","attack":"远程","roles":["耐久","核心","控制","先手"],"positions":[2,3],"positionLabels":["2 号位","3 号位"],"positionNames":["中路核心","劣势路核心"],"lanes":["中路","劣势路"],"complexity":1,"complexityLabel":"简单","icon":"assets/heroes/icons/viper.png","art":"assets/heroes/art/viper.jpg","card":"assets/heroes/cards/viper.png","winrate":48.72,"pickrate":8.53,"trend":[48.48,48.66,48.8,48.84,48.9,48.6,49.11],"delta":0.63,"pubPick":327098,"pubWin":159348,"proPick":12,"proWin":7,"proBan":48,"lore":"一个暴虐凶残的巫师捕获了蝮蛇，希望驯服它作为自己的凶狠宠物，好奇的蝮蛇很乐意从地下被带离封闭不化的三途川，在地壳滑移中冥界亚龙们被封在了这一带闪着幽光的洞穴中，因此整个种族也已经在那里居住了成千上万年。蝮蛇一开始还愿意理解并服从巫师的命令，希望能学到他最高超的黑暗魔法。但它很快就发现，没多少咒语比它与生俱来的毒液更致命。蝮蛇流出的酸液很快就腐蚀掉了它笼子上的铁柱，冥界亚龙挣脱了囚禁，将它的毒液吐到了老巫师的眼睛，它展翅飞入高空，向世界宣告新的主宰已经到来。","hype":"冥界亚龙不必近身就可以喷射致命的剧毒，无论是谁都抵受不了。他周身的多种毒素可以蚕食敌人的生命，使他们行动迟缓。冥界亚龙仅仅是在表演他的拿手绝活：不断地增加剂量。","npe":"剧毒的毒素可以降低魔法抗性并造成减速","stats":{"health":582,"healthRegen":2.35,"mana":279,"manaRegen":0.85,"damage":"48–50","armor":1.5,"magicResistance":25,"moveSpeed":275,"attackRange":575,"attackRate":1.7,"turnRate":0.6,"sightDay":1800,"sightNight":800,"str":{"base":21,"gain":2.4},"agi":{"base":21,"gain":2.9},"int":{"base":17,"gain":2}},"abilities":[{"id":5218,"key":"viper_poison_attack","name":"毒性攻击","en":"Poison Attack","desc":"蝮蛇的毒液得到强化，使他的普通攻击附带效果，可以降低目标的移动速度和魔法抗性，并持续造成伤害。效果可以叠加，最多叠加6次。","lore":"冥界亚龙天生带有剧毒的吐息能迅速抽干敌人的生命力。","notes":[],"shard":"提升最大叠加次数，毒性攻击可以降低护甲，并且可以作用于建筑，造成的伤害有所降低。","scepter":"","values":[{"key":"duration","label":"持续时间","value":"4 秒"},{"key":"damage","label":"每秒伤害","value":"4 / 8 / 12 / 16"},{"key":"movement_speed","label":"移动速度减缓","value":"3% / 6% / 9% / 12%"},{"key":"magic_resistance","label":"魔法抗性降低","value":"4% / 6% / 8% / 10%"},{"key":"max_stacks","label":"最大叠加次数","value":"6","shard":"2"},{"key":"shard_armor_reduction","label":"护甲降低","value":"0%","shard":"1%"},{"key":"shard_building_dmg_pct","label":"对建筑伤害","value":"0%","shard":"40%"}],"chips":[{"label":"魔法","value":"20"},{"label":"施法距离","value":"600"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/viper_poison_attack.png","maxLevel":4,"hasShard":true,"hasScepter":false},{"id":5219,"key":"viper_nethertoxin","name":"幽冥剧毒","en":"Nethertoxin","desc":"蝮蛇向目标区域释放幽冥剧毒。范围内的单位持续受到伤害，在区域内停留的时间越长，受到的伤害也越高。同时他们的攻击速度会被降低。","lore":"三途川的剧毒让小伤也能致死，而疲乏可以送命。","notes":["多个幽冥剧毒不会叠加。"],"shard":"","scepter":"","values":[{"key":"min_damage","label":"最低每秒伤害","value":"15 / 25 / 35 / 45"},{"key":"max_damage","label":"最高每秒伤害","value":"35 / 65 / 95 / 125"},{"key":"max_duration","label":"最高每秒伤害所需时间","value":"4 秒"},{"key":"radius","label":"作用范围","value":"400"},{"key":"attack_slow","label":"攻击速度降低","value":"30% / 40% / 50% / 60%"},{"key":"duration","label":"持续时间","value":"6.5 / 7 / 7.5 / 8 秒"}],"chips":[{"label":"冷却","value":"14 秒"},{"label":"魔法","value":"70"},{"label":"施法距离","value":"900"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/viper_nethertoxin.png","maxLevel":4,"hasShard":false,"hasScepter":false},{"id":5220,"key":"viper_corrosive_skin","name":"腐蚀皮肤","en":"Corrosive Skin","desc":"蝮蛇分泌出感染性的毒素，1200范围内任何伤害它的敌人都将受到伤害，同时攻击速度也被降低。这种酸性分泌物还能提高蝮蛇的魔法抗性。","lore":"对冥界亚龙出击后，手中的刀剑和盾牌会遭到腐蚀并不稀奇。","notes":["与其他提升魔法抗性的物品和技能叠加。","破坏会使腐蚀皮肤不再施加效果。极恶俯冲还是会施加腐蚀皮肤。","这个技能造成的伤害被视为反弹伤害。反弹伤害不提供任何吸血，而且无法反弹。"],"shard":"","scepter":"腐蚀皮肤会对距离冥界亚龙0范围内的敌人施加0倍攻击速度降低效果。当冥界亚龙处于幽冥剧毒中，腐蚀皮肤的魔法抗性和每秒伤害会逐渐提升，在0秒后，达到最高的0%提升。","values":[{"key":"duration","label":"持续时间","value":"4 秒"},{"key":"bonus_attack_speed","label":"攻击速度降低","value":"9% / 18% / 27% / 36%"},{"key":"bonus_magic_resistance","label":"魔法抗性加成","value":"10% / 15% / 20% / 25%"},{"key":"damage","label":"每秒伤害","value":"10 / 15 / 20 / 25"},{"key":"max_range","label":"最大作用范围","value":"1200"}],"chips":[],"type":"passive","typeLabel":"被动","icon":"assets/abilities/viper_corrosive_skin.png","maxLevel":4,"hasShard":false,"hasScepter":true},{"id":983,"key":"viper_nose_dive","name":"极恶俯冲","en":"Nosedive","desc":"冥界亚龙冲向地面，释放幽冥剧毒并且500范围内所有敌人均被溅上持续4秒的腐蚀皮肤酸液。","lore":"世人认为冥界亚龙的翅膀只有在死亡时才会碰到地面，不过也有揣测是有人见证了更为刻意的着陆，只是没能活着说出他的故事。","notes":[],"shard":"","scepter":"","values":[{"key":"corrosive_radius","label":"范围","value":"500"},{"key":"effect_duration","label":"效果持续时间","value":"4 秒"}],"chips":[{"label":"冷却","value":"25 秒"},{"label":"魔法","value":"75"},{"label":"施法距离","value":"700"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/viper_nose_dive.png","maxLevel":1,"hasShard":false,"hasScepter":false},{"id":1461,"key":"viper_predator","name":"掠食","en":"Predator","desc":"冥界亚龙的攻击会根据目标英雄缺失的生命百分比额外造成一次物理伤害。","lore":"","notes":[],"shard":"","scepter":"","values":[{"key":"damage","label":"伤害","value":"0.25"}],"chips":[],"type":"innate","typeLabel":"先天技能","icon":"assets/abilities/viper_predator.png","maxLevel":1,"hasShard":false,"hasScepter":false},{"id":5221,"key":"viper_viper_strike","name":"蝮蛇突袭","en":"Viper Strike","desc":"蝮蛇降低敌方目标单位的移动和攻击速度，同时破坏其被动技能并造成持续毒素伤害。移动和攻击速度会在毒素的持续时间内逐渐恢复。","lore":"冥界亚龙身上最具威力的毒素，曾用于屠戮它残酷的主人。不论是谁，只要愚蠢到与蝮蛇作对就会被毒杀。","notes":[],"shard":"","scepter":"","values":[{"key":"duration","label":"持续时间","value":"6 秒"},{"key":"damage","label":"每秒伤害","value":"70 / 110 / 150"},{"key":"bonus_movement_speed","label":"移动速度减缓","value":"60% / 70% / 80%"},{"key":"bonus_attack_speed","label":"攻击速度降低","value":"100% / 140% / 180%"}],"chips":[{"label":"冷却","value":"50 / 40 / 30 秒"},{"label":"魔法","value":"100 / 150 / 200"},{"label":"施法距离","value":"750"}],"type":"ultimate","typeLabel":"终极技能","icon":"assets/abilities/viper_viper_strike.png","maxLevel":3,"hasShard":false,"hasScepter":false}],"talents":[{"level":10,"options":[{"key":"special_bonus_unique_viper_4","name":"+1秒 蝮蛇突袭持续时间","en":"+1s Viper Strike Duration"},{"key":"special_bonus_unique_viper_1","name":"+15 腐蚀皮肤每秒伤害","en":"+15 Corrosive Skin Damage Per Second"}]},{"level":15,"options":[{"key":"special_bonus_unique_viper_3","name":"+20/40 幽冥剧毒最低/最高伤害","en":"+20/40 Nethertoxin Min/Max Damage"},{"key":"special_bonus_unique_viper_7","name":"+15% 毒性攻击减速/伤害","en":"+15% Poison Attac