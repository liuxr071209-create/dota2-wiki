{"id":8,"slug":"juggernaut","name":"主宰","en":"Juggernaut","aliases":["剑圣","jug"],"attr":"agi","attrLabel":"敏捷","attack":"近战","roles":["核心","逃生","推进"],"positions":[1],"positionLabels":["1 号位"],"positionNames":["优势路核心"],"lanes":["优势路"],"complexity":1,"complexityLabel":"简单","icon":"assets/heroes/icons/juggernaut.png","art":"assets/heroes/art/juggernaut.jpg","card":"assets/heroes/cards/juggernaut.png","winrate":52.52,"pickrate":18.03,"trend":[52.61,52.5,52.34,52.6,52.41,52.55,52.93],"delta":0.32,"pubPick":691326,"pubWin":363112,"proPick":3,"proWin":1,"proBan":2,"lore":"没有人见过主宰尤涅若面具下的真面目。甚至有人认为他没有脸部。作为公然反抗腐败领主的惩罚，主宰被古老的遮面之岛流放了，这反而救了他的性命。不久后海岛在一个充斥着复仇魔法的夜晚被海浪彻底毁灭了。岛屿上古老的主宰传统，礼法和剑术都由他独自继承。作为这项传统最后的开拓者，尤涅若的自信和勇气来自他坚持不懈的锻炼，他独创的剑术证明他从未停止挑战自我。一如既往的，他的内心和他的表情一样难以捉摸。作为一位曾两度失去一切的英雄，主宰斗志昂扬，仿佛胜利已是定局。","hype":"一阵刀光剑影过后，主宰的敌人就已被他斩落。他以剑刃的旋转切入战斗，在战场上英勇无畏，迅疾非常，敌人基本没有招架的余地，抵挡住主宰就跟从他手中逃脱一样绝非易事。","npe":"精准的出招在敌阵之中斩击","stats":{"health":560,"healthRegen":2.5,"mana":243,"manaRegen":0.7,"damage":"54–56","armor":5.3,"magicResistance":25,"moveSpeed":305,"attackRange":150,"attackRate":1.4,"turnRate":0.6,"sightDay":1800,"sightNight":800,"str":{"base":20,"gain":2},"agi":{"base":32,"gain":2.8},"int":{"base":14,"gain":1.4}},"abilities":[{"id":5028,"key":"juggernaut_blade_fury","name":"剑刃风暴","en":"Blade Fury","desc":"舞起具有破坏性力量的剑刃风暴，使主宰获得减益免疫状态，魔法抗性提升80%，并且每0.2秒对主宰周围的敌方单位造成伤害。旋转结束时施加强驱散效果。","lore":"无论是战士还是法师，都害怕尤涅若的武士刀剑技。","notes":["剑刃风暴期间可以使用物品。","主宰在施放剑刃风暴的过程中依然可以进行物理攻击。但是只有不受剑刃风暴伤害的单位，如守卫和建筑才会受到这些物理伤害。"],"shard":"","scepter":"提升作用范围并减速范围内的敌人。\n\n主宰每%attack_interval%秒对作用的敌人发动一次攻击。","values":[{"key":"blade_fury_damage","label":"每秒造成伤害","value":"85 / 115 / 145 / 175"},{"key":"blade_fury_damage_tick","label":"伤害频率","value":"0.2"},{"key":"blade_fury_radius","label":"作用范围","value":"260"},{"key":"duration","label":"持续时间","value":"5 秒"}],"chips":[{"label":"冷却","value":"30 / 26 / 22 / 18 秒"},{"label":"魔法","value":"110"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/juggernaut_blade_fury.png","maxLevel":4,"hasShard":false,"hasScepter":false},{"id":5029,"key":"juggernaut_healing_ward","name":"治疗守卫","en":"Healing Ward","desc":"召唤一个治疗守卫，按周围友军单位最大生命值的一定比例治疗他们。治疗守卫可以移动，移动速度为325。持续18 / 20 / 22 / 24秒。","lore":"在遮面之岛习得的仪式之一，治疗伤口时加上一点巫毒法术往往会很有效。","notes":["可以控制治疗守卫。","多个治疗守卫的效果不会叠加。"],"shard":"提升守卫的治疗量和生命值。","scepter":"","values":[{"key":"healing_ward_heal_amount","label":"每秒最大生命值回复","value":"2% / 3% / 4% / 5%","shard":"1.5%"},{"key":"healing_ward_aura_radius","label":"作用范围","value":"400"},{"key":"healing_ward_hits_to_kill_tooltip","label":"摧毁所需次数","value":"1"}],"chips":[{"label":"冷却","value":"60 秒"},{"label":"魔法","value":"120"},{"label":"施法距离","value":"350"},{"label":"持续时间","value":"18 / 20 / 22 / 24 秒"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/juggernaut_healing_ward.png","maxLevel":4,"hasShard":true,"hasScepter":false},{"id":5027,"key":"juggernaut_blade_dance","name":"剑舞","en":"Blade Dance","desc":"主宰有一定概率在攻击时触发致命一击。","lore":"作为他对剑技传承的最后承诺，尤涅若立誓将使此剑技为世人所铭记。","notes":[],"shard":"","scepter":"","values":[{"key":"blade_dance_crit_chance","label":"致命一击概率","value":"35%"},{"key":"blade_dance_crit_mult","label":"致命一击伤害","value":"140% / 160% / 180% / 200%"}],"chips":[],"type":"passive","typeLabel":"被动","icon":"assets/abilities/juggernaut_blade_dance.png","maxLevel":4,"hasShard":false,"hasScepter":false},{"id":419,"key":"juggernaut_swift_slash","name":"迅风斩","en":"Swiftslash","desc":"发动一次短时间的无敌斩，持续1秒。","lore":"为了不配获得荣耀的人准备的短暂猛攻。","notes":[],"shard":"","scepter":"","values":[{"key":"duration","label":"持续时间","value":"1 秒"}],"chips":[{"label":"冷却","value":"25 秒"},{"label":"魔法","value":"150"},{"label":"施法距离","value":"450"}],"type":"active","typeLabel":"主动","icon":"assets/abilities/juggernaut_swift_slash.png","maxLevel":1,"hasShard":false,"hasScepter":true},{"id":1210,"key":"juggernaut_bladeform","name":"剑心犹在","en":"Bladeform","desc":"主宰未受到伤害时每2秒获得一层剑心的叠加层数。每层叠加效果提供基础敏捷和移动速度加成。叠加效果在受到任何伤害时会粘滞2秒后再消失。","lore":"","notes":["破坏会使技能无法获得新的叠加效果。","破坏不会使现有叠加效果提供的加成失效。"