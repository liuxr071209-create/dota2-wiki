","name":"森海飞霞","icon":"assets/heroes/icons/hoodwink.png","winrate":35.71,"games":56},{"slug":"snapfire","name":"电炎绝手","icon":"assets/heroes/icons/snapfire.png","winrate":35.8,"games":81}],"strong":[{"slug":"slardar","name":"斯拉达","icon":"assets/heroes/icons/slardar.png","winrate":60.71,"games":56},{"slug":"mars","name":"玛尔斯","icon":"assets/heroes/icons/mars.png","winrate":60,"games":65},{"slug":"dark_willow","name":"邪影芳灵","icon":"assets/heroes/icons/dark_willow.png","winrate":60,"games":45},{"slug":"ringmaster","name":"百戏大王","icon":"assets/heroes/icons/ringmaster.png","winrate":60,"games":25},{"slug":"lich","name":"巫妖","icon":"assets/heroes/icons/lich.png","winrate":59.38,"games":32}]},"winRank":5,"pickRank":30}